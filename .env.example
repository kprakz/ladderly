# Copy to .env.local.

# Demo mode: serve built-in sample paths instead of calling the API (free, no key needed).
DEMO_MODE=true

# Needed only when DEMO_MODE is not "true". Get a key from https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional: OpenAI key used when a user picks OpenAI without adding their own key.
OPENAI_API_KEY=

# Website download counter (optional). Connect a free Upstash Redis database in Vercel (Storage -> Marketplace),
# which sets these two automatically. Without them, downloads still work but aren't counted.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# Where "Download for Windows" points (default: the latest GitHub release's Ladderly-Setup.exe).
# LADDERLY_DOWNLOAD_URL=

# Password for the private feedback inbox at /admin/feedback (at least 12 characters). Feedback is stored in
# the same Upstash database as the download counts.
# FEEDBACK_ADMIN_TOKEN=
# Where the desktop app sends feedback (the public website).
# LADDERLY_SITE_URL=https://ladderly.vercel.app

# Optional: a web-search key for everyone using this server (users can also add their own in AI settings).
# TAVILY_API_KEY=
# BRAVE_SEARCH_API_KEY=

# Local models (Ollama). Used by the desktop app and `npm run dev`; set LADDERLY_LOCAL=1 to enable them when
# self-hosting with `npm start` on your own computer. Never enable this on a public server.
# OLLAMA_HOST=127.0.0.1:11434
# LADDERLY_LOCAL=1
